# Local development template. Do not set NODE_ENV here: the Vercel API requires
# NODE_ENV=production and Vercel provides it for production functions.
# Required locally and in production. Never commit a real value.
DATABASE_URL=postgresql://USER:***@HOST:5432/DATABASE?sslmode=require

# Optional locally; Vercel manages the function port.
PORT=3000

# Local client origin. In the API Vercel project, set this to the exact HTTPS
# production client origin (no path, query, fragment, or wildcard).
CLIENT_ORIGIN=http://localhost:3001

# Leave unset locally. Both are required in the API Vercel project's Production
# environment for shared-atomic authentication admission limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local COD automation only. Run the documented provisioning command first;
# it prints N8N_ACTOR_ID. Do not invent an ID or use a human account ID.
N8N_COD_ENABLED=0
N8N_ACTOR_ID=
N8N_SERVICE_TOKEN=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
# Optional: local single-process API dispatch every 5 seconds. Never enable on
# production/serverless workers; use an external scheduler there.
NEXAMART_LOCAL_OUTBOX_DISPATCH_ENABLED=0

# Optional customer Telegram linking. Set only after the dedicated NexaMart bot
# and local n8n link-poll workflow are configured and activated.
TELEGRAM_BOT_USERNAME=
